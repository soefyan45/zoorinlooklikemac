# Zorin Notch: zorin-taskbar as a floating dock (Pego frame nq00cgxh, dock 7zy0knoo).
# Load with scripts/apply-dock.sh (makes a backup first). Monitor keys: index 0/1 and the
# laptop panel id; the taskbar falls back to the monitor index for other monitors.
[/]
panel-position='BOTTOM'
panel-positions='{"0":"BOTTOM","1":"BOTTOM","SDC-0x00000000":"BOTTOM"}'
panel-anchors='{"0":"MIDDLE","1":"MIDDLE","SDC-0x00000000":"MIDDLE"}'
panel-lengths='{"0":-1,"1":-1,"SDC-0x00000000":-1}'
panel-element-positions='{"0":[{"element":"showAppsButton","visible":false,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":false,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"centered"},{"element":"centerBox","visible":false,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":false,"position":"stackedBR"},{"element":"dateMenu","visible":false,"position":"stackedBR"},{"element":"desktopButton","visible":false,"position":"stackedBR"}],"1":[{"element":"showAppsButton","visible":false,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":false,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"centered"},{"element":"centerBox","visible":false,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":false,"position":"stackedBR"},{"element":"dateMenu","visible":false,"position":"stackedBR"},{"element":"desktopButton","visible":false,"position":"stackedBR"}],"SDC-0x00000000":[{"element":"showAppsButton","visible":false,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":false,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"centered"},{"element":"centerBox","visible":false,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":false,"position":"stackedBR"},{"element":"dateMenu","visible":false,"position":"stackedBR"},{"element":"desktopButton","visible":false,"position":"stackedBR"}]}'
panel-element-positions-monitors-sync=true
panel-size=40
panel-margin=5
global-border-radius=4
trans-use-custom-opacity=true
trans-panel-opacity=0.0
trans-use-border=false
trans-border-width=1
dot-style-focused='DOTS'
dot-style-unfocused='DOTS'
show-showdesktop-icon=false
